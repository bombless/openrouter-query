import { Button, LineEdit, TextEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

struct ModelItem {
    id: string,
    name: string,
    details: string,
}

export component AppWindow inherits Window {
    title: "OpenRouter Query";
    min-width: 1040px;
    min-height: 760px;
    background: #10141d;

    in-out property<string> api-key: "";
    in-out property<string> status-text: "输入 OpenRouter API Key，然后点击「查询数据」";
    in-out property<string> key-label: "—";
    in-out property<string> usage-total: "—";
    in-out property<string> usage-daily: "—";
    in-out property<string> usage-weekly: "—";
    in-out property<string> usage-monthly: "—";
    in-out property<string> limit-remaining: "—";
    in-out property<string> free-used: "—";
    in-out property<string> free-limit: "—";
    in-out property<string> free-remaining: "—";
    in-out property<string> free-model-count: "—";
    in-out property<[ModelItem]> models: [];
    in-out property<string> selected-model-id: "";
    in-out property<string> selected-model-name: "未选择模型";
    in-out property<string> chat-input: "";
    in-out property<string> chat-text: "从免费模型列表中选择模型，即可开始对话。";
    in-out property<bool> busy: false;

    callback refresh-requested();
    callback select-model-requested(string);
    callback send-requested();

    VerticalBox {
        padding: 22px;
        spacing: 12px;
        HorizontalBox {
            alignment: center;
            spacing: 12px;
            Text { text: "OpenRouter Query"; color: #f3f6fc; font-size: 26px; font-weight: 700; }
            Rectangle { background: transparent; }
            Text { text: "SLINT · NODE.JS"; color: #7f91aa; font-size: 11px; }
        }
        Text { text: "API KEY"; color: #9eacc0; font-size: 11px; font-weight: 700; }
        HorizontalBox {
            spacing: 10px;
            LineEdit { text <=> root.api-key; input-type: password; placeholder-text: "sk-or-v1-..."; height: 40px; }
            Button { text: root.busy ? "处理中…" : "查询数据"; enabled: !root.busy && root.api-key != ""; clicked => { root.refresh-requested(); } }
        }
        Text { text: root.status-text; color: #9eacc0; font-size: 11px; wrap: word-wrap; }
        Text { text: "API KEY 使用统计"; color: #f3f6fc; font-size: 16px; font-weight: 700; }
        HorizontalBox {
            spacing: 8px;
            for item in [
                { label: "累计消费", value: root.usage-total },
                { label: "今日消费 (UTC)", value: root.usage-daily },
                { label: "本周消费 (UTC)", value: root.usage-weekly },
                { label: "本月消费 (UTC)", value: root.usage-monthly },
                { label: "Key 剩余额度", value: root.limit-remaining },
                { label: "免费请求剩余", value: root.free-remaining }
            ]: Rectangle {
                background: #1b2432; border-radius: 8px; padding: 10px; min-height: 62px;
                VerticalBox { spacing: 5px;
                    Text { text: item.label; color: #9eacc0; font-size: 10px; }
                    Text { text: item.value; color: #f4f7fb; font-size: 16px; font-weight: 700; }
                }
            }
        }
        HorizontalBox {
            spacing: 12px;
            Rectangle {
                width: 390px; background: #151d29; border-radius: 9px; padding: 12px;
                VerticalBox {
                    spacing: 8px;
                    HorizontalBox {
                        Text { text: "免费模型"; color: #f3f6fc; font-size: 16px; font-weight: 700; }
                        Rectangle { background: transparent; }
                        Text { text: root.free-model-count; color: #72d6aa; font-size: 13px; }
                    }
                    Text { text: "滚动列表，点击模型开始新对话"; color: #8798ad; font-size: 10px; }
                    ScrollView {
                        height: 480px;
                        VerticalBox {
                            spacing: 6px;
                            for model in root.models: Rectangle {
                                background: model.id == root.selected-model-id ? #26394a : #1b2432;
                                border-radius: 7px; padding: 9px; min-height: 64px;
                                TouchArea {
                                    clicked => { root.select-model-requested(model.id); }
                                    VerticalBox {
                                        spacing: 4px;
                                        Text { text: model.name; color: #e9f0f8; font-size: 11px; font-weight: 700; wrap: word-wrap; }
                                        Text { text: model.id; color: #72d6aa; font-size: 9px; wrap: word-wrap; }
                                        Text { text: model.details; color: #91a2b7; font-size: 9px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: #151d29; border-radius: 9px; padding: 12px;
                VerticalBox {
                    spacing: 8px;
                    HorizontalBox {
                        Text { text: "多轮对话"; color: #f3f6fc; font-size: 16px; font-weight: 700; }
                        Rectangle { background: transparent; }
                        Text { text: root.selected-model-name; color: #72d6aa; font-size: 11px; }
                    }
                    ScrollView {
                        height: 420px;
                        TextEdit {
                            text: root.chat-text;
                            read-only: true;
                            wrap: word-wrap;
                            color: #d4deeb;
                            font-size: 12px;
                        }
                    }
                    Text { text: "消息"; color: #9eacc0; font-size: 10px; }
                    TextEdit {
                        text <=> root.chat-input;
                        height: 76px;
                        wrap: word-wrap;
                        color: #f3f6fc;
                    }
                    HorizontalBox {
                        alignment: end;
                        Button {
                            text: root.busy ? "生成中…" : "发送";
                            enabled: !root.busy && root.chat-input != "" && root.selected-model-id != "";
                            clicked => { root.send-requested(); }
                        }
                    }
                }
            }
        }
        Text {
            text: "API Key 保存在系统凭据库；模型对话使用 /chat/completions，切换模型会开启新会话。免费请求额度为账户级统计。";
            color: #74849a; font-size: 10px; wrap: word-wrap;
        }
    }
}
